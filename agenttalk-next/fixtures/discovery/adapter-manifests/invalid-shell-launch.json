{
  "schemaVersion": "agenttalk.adapter.v1",
  "id": "org.fixture.agent",
  "displayName": "Fixture Agent",
  "category": "agent_protocol",
  "protocol": {
    "kind": "acp",
    "major": 1
  },
  "match": {
    "executableNames": ["fixture-agent.exe"]
  },
  "launch": {
    "kind": "direct",
    "transport": "stdio",
    "executableRef": "matched-observation",
    "args": ["cmd /C fixture-agent.exe"],
    "environmentAllowlist": ["PATH"]
  },
  "verification": {
    "kind": "acp_initialize",
    "timeoutMs": 3000
  },
  "capabilityPolicy": {
    "filesystem": "negotiate",
    "shell": "negotiate",
    "streaming": "required",
    "cancel": "required"
  }
}
