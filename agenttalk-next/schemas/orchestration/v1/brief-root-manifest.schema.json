{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttalk:schema:orchestration:v1:brief-root-manifest",
  "title": "AgentTalk Brief Root Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "roles",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "agenttalk.brief.manifest.v1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "displayName"
      ],
      "properties": {
        "roleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "roleIds",
        "retention",
        "workspaceAccess"
      ],
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "persistent",
            "shared",
            "role"
          ]
        },
        "roleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          }
        },
        "retention": {
          "type": "string",
          "enum": [
            "project",
            "run"
          ]
        },
        "workspaceAccess": {
          "type": "string",
          "enum": [
            "none",
            "read_only",
            "workspace_write"
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "format",
        "contentSchemaRef",
        "required",
        "sha256",
        "size",
        "context",
        "declaredOwnerRoleId"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "plan",
            "design",
            "role",
            "constraint",
            "rhythm",
            "acceptance"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "markdown",
            "json",
            "text"
          ]
        },
        "contentSchemaRef": {
          "oneOf": [
            {
              "$ref": "#/$defs/schemaRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "declaredOwnerRoleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "contentSchemaRef": {
                "$ref": "#/$defs/schemaRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "acceptance"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "format": {
                    "const": "json"
                  }
                }
              },
              {
                "properties": {
                  "contentSchemaRef": {
                    "$ref": "#/$defs/schemaRef"
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "contentSchemaRef": {
                "const": null
              }
            },
            "required": [
              "contentSchemaRef"
            ]
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "format": {
                    "enum": [
                      "markdown",
                      "text"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "enum": [
                      "plan",
                      "design",
                      "role",
                      "constraint",
                      "rhythm"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
